{
  "name": "caime",
  "private": true,
  "version": "0.1.0",
  "description": "Caime — messaging that understands your relationships.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "pnpm --filter @caime/server dev",
    "dev:app": "pnpm --filter @caime/app start",
    "dev:phone": "node scripts/dev-phone.mjs",
    "build": "pnpm --filter @caime/app build:web && node scripts/precompress.mjs apps/app/dist && pnpm --filter @caime/server build",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "start": "node --enable-source-maps apps/server/dist/server.js",
    "budget": "node scripts/bundle-budget.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.56.1",
    "@types/smtp-server": "^3.5.13",
    "smtp-server": "^3.19.15",
    "typescript": "~6.0.3"
  }
}
