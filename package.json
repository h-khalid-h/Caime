{
  "name": "caishy",
  "private": true,
  "version": "0.1.0",
  "description": "Caishy — messaging that understands your relationships.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev:server": "pnpm --filter @caishy/server dev",
    "dev:app": "pnpm --filter @caishy/app start",
    "build": "pnpm --filter @caishy/app build:web && pnpm --filter @caishy/server build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "~6.0.3"
  }
}
