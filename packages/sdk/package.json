{
  "name": "@caime/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "A typed client for Caime's API and its webhook signatures, for organizations' apps (Node 22+).",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@caime/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "vitest": "^5.0.2"
  }
}
