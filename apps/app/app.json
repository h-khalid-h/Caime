{
  "expo": {
    "name": "Caime",
    "slug": "caime",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/brand/icon.png",
    "scheme": "caime",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FAF8FC",
    "ios": {
      "bundleIdentifier": "me.cai.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Caime uses the camera for video calls, and when you take a photo to send.",
        "NSPhotoLibraryUsageDescription": "Caime opens your photos when you choose one to send.",
        "NSMicrophoneUsageDescription": "Caime uses the microphone for calls, and when you record a voice message.",
        "NSLocationWhenInUseUsageDescription": "Caime uses your location only when you choose to share it.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "me.cai.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF8FB1",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "single",
      "name": "Caime",
      "shortName": "Caime",
      "description": "Messaging that understands your relationships.",
      "themeColor": "#3B2E5B",
      "backgroundColor": "#FAF8FC"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7E9",
          "image": "./assets/brand/splash.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#120F1A",
            "image": "./assets/brand/splash.png"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-audio",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Caime uses your location only when you choose to share it in a conversation, once, never in the background.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Caime uses the camera for video calls, and when you take a photo to send.",
          "microphonePermission": "Caime uses the microphone for calls, and when you record a voice message."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
