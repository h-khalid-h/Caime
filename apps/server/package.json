{
  "name": "@caishy/server",
  "version": "0.1.0",
  "private": true,
  "description": "Caishy API, realtime and workers.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/server.js",
    "build": "node build.mjs",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@caishy/core": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.2",
    "ws": "^8.21.3"
  }
}
