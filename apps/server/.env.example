# Copy to .env for local development. Every variable is documented in src/config.ts.
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://caishy:caishy-dev@127.0.0.1:5432/caishy
DATA_DIR=./data
# The Expo dev server (web) calls the API from another port in development.
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info
# Optional
# METRICS_TOKEN=
# DNS servers for checking organizations' domains (default: the system's)
# DNS_SERVERS=1.1.1.1,8.8.8.8
# The operator's token for /v1/admin (plans, handles, reports); 24 characters or more.
# ADMIN_TOKEN=
# Or one per person on the operator's side, so the audit log says who acted.
# OPERATOR_TOKENS=mona:<24+ characters>,ali:<24+ characters>
# PLANS_URL=https://caime.example.com/plans
# Who runs this Caime and where to write to them, as its /privacy, /terms and /help pages say.
# LEGAL_NAME=DATA C OÜ
# CONTACT_EMAIL=hello@cai.me
# LEGAL_ADDRESS=Street 1, 10111 Tallinn, Estonia   # the operator's postal address, on the privacy page and the terms
# GOVERNING_LAW=Estonia                            # the law and courts the terms are under; unset, the clause is left out
# A privacy policy, terms or help published somewhere else, instead of Caime's own page for it.
# PRIVACY_URL=https://policies.example.com/caime/privacy
# TERMS_URL=https://policies.example.com/caime/terms
# HELP_URL=https://help.example.com/caime
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# A smaller model for rewrite, translate and catch me up (docs/RESOURCES.md); unset, the one above.
# ANTHROPIC_MODEL_LIGHT=
# Voice notes into words (PRD §46, docs/SPEECH.md): openai or elevenlabs, its key, and the model
# (the provider's default when unset: gpt-4o-transcribe, scribe_v1). Off without the first two.
# SPEECH_PROVIDER=openai
# SPEECH_API_KEY=
# SPEECH_MODEL=
# EXPO_ACCESS_TOKEN=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Calls: STUN servers (empty for none), and a TURN relay with its shared secret
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=
# Or Cloudflare's relay: a TURN key's id and API token (Cloudflare dashboard, Realtime, TURN Server)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Local development only: lets app webhooks reach localhost over plain http.
# WEBHOOKS_ALLOW_PRIVATE=true

# Database backups (docs/DEPLOY.md, "Backups"): a pg_dump a day, kept 30 days in DATA_DIR/backups.
# BACKUP_ENABLED=true
# BACKUP_DIR=/data/backups
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=30
# A copy of each backup off the host, to an S3-compatible bucket (docs/DEPLOY.md): all four, or none.
# BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=caime/backups/
# BACKUP_S3_PATH_STYLE=true

# Files in an S3-compatible bucket rather than on DATA_DIR (docs/DEPLOY.md, "Scaling"): all four, or none.
# FILES_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# FILES_S3_BUCKET=
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_REGION=auto
# FILES_S3_PREFIX=caime/files/
# FILES_S3_PATH_STYLE=true

# Mail (R48): the code that confirms an address and the link that resets a password.
# Without SMTP_URL nothing is sent and recovery codes are the way back.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM=Caime <hello@cai.me>
