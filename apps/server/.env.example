# Copy to .env for local development. Every variable is documented in src/config.ts.
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://caishy:caishy-dev@127.0.0.1:5432/caishy
DATA_DIR=./data
# The Expo dev server (web) calls the API from another port in development.
CORS_ORIGINS=http://localhost:8081
LOG_LEVEL=info
# Optional
# METRICS_TOKEN=
# DNS servers for checking organizations' domains (default: the system's)
# DNS_SERVERS=1.1.1.1,8.8.8.8
# The operator's token for /v1/admin (plans, handles, reports); 24 characters or more.
# ADMIN_TOKEN=
# Or one per person on the operator's side, so the audit log says who acted.
# OPERATOR_TOKENS=mona:<24+ characters>,ali:<24+ characters>
# PLANS_URL=https://caime.example.com/plans
# Who runs this Caime and where to write to them, as its /privacy, /terms and /help pages say.
# LEGAL_NAME=DATA C OÜ
# CONTACT_EMAIL=hello@cai.me
# LEGAL_ADDRESS=Street 1, 10111 Tallinn, Estonia   # the operator's postal address, on the privacy page and the terms
# GOVERNING_LAW=Estonia                            # the law and courts the terms are under; unset, the clause is left out
# LEGAL_REGISTRATION=Estonian Commercial Register 12345678   # the register entry, on the privacy page and the terms
# A privacy policy, terms or help published somewhere else, instead of Caime's own page for it.
# PRIVACY_URL=https://policies.example.com/caime/privacy
# TERMS_URL=https://policies.example.com/caime/terms
# HELP_URL=https://help.example.com/caime
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# The model for everything but a payer's follow-ups and organization agent (docs/RESOURCES.md,
# "What a person costs"); Haiku 5.5 when unset.
# ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
# Voice notes into words (PRD §46, docs/SPEECH.md): openai or elevenlabs, its key, and the model
# (the provider's default when unset: gpt-4o-transcribe, scribe_v1). Off without the first two.
# SPEECH_PROVIDER=openai
# SPEECH_API_KEY=
# SPEECH_MODEL=
# EXPO_ACCESS_TOKEN=
# The phone apps' claim on PUBLIC_URL's domain (R35: links open the app, its passkeys work in it):
# Apple's team id and the Android signing certificates' SHA-256 (comma separated). Unset, the
# /.well-known/ files answer 404 and links open in the browser.
# APPLE_TEAM_ID=
# ANDROID_CERT_SHA256=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Calls: STUN servers (empty for none), and a TURN relay with its shared secret
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=
# Or Cloudflare's relay: a TURN key's id and API token (Cloudflare dashboard, Realtime, TURN Server)
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# Contacts from someone's Google or Microsoft account, read once on their device when they ask
# (PRODUCT-REVIEW R89): each provider's OAuth client, a web application whose redirect address
# is PUBLIC_URL/v1/contacts/accounts/google/back (or /microsoft/back). Unset, not offered.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# Phone numbers proven by a code over WhatsApp (PRODUCT-REVIEW R91; docs/DEPLOY.md): Meta's
# Cloud API, a permanent system user token and the sending number's id. Unset, not offered.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=caime_code
# WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Local development only: lets app webhooks reach localhost over plain http.
# WEBHOOKS_ALLOW_PRIVATE=true
# Link previews (M16 E4c): the server reads the page of a text's first link once, kept 30 days.
# LINK_PREVIEWS=true
# Tests only: lets link previews read localhost.
# LINK_PREVIEWS_ALLOW_PRIVATE=true

# The agent's nightly evaluation (M16 G6c): Caime's questions put to each plan's model, where AI
# assist is on.
# AGENT_EVAL_ENABLED=true

# Database backups (docs/DEPLOY.md, "Backups"): a pg_dump a day, kept 30 days in DATA_DIR/backups.
# BACKUP_ENABLED=true
# BACKUP_DIR=/data/backups
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=30
# A copy of each backup off the host, to an S3-compatible bucket (docs/DEPLOY.md): all four, or none.
# BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=caime/backups/
# BACKUP_S3_PATH_STYLE=true
# Each backup encrypted before it's kept or copied (M16 B5; docs/DEPLOY.md, "Backups"): 32 random
# bytes (openssl rand -base64 32), kept apart from the backups; restoring one needs it.
# BACKUP_KEY=

# The key connected accounts' tokens are sealed with, held here and never in the database
# (M16 B5; docs/DEPLOY.md, "Keys apart from the data"): 32 random bytes (openssl rand -base64 32),
# set once and kept. To replace it, the new one here and the old one in VAULT_KEY_PREVIOUS until
# caime_vault_sealed{key="older"} reads 0. Unset, the database's own key seals, as before.
# VAULT_KEY=
# VAULT_KEY_PREVIOUS=

# Age checks (M16 B7, docs/DEPLOY.md "Age checks"): who checks an age when Caime asks for one.
# Off without the provider and its keys; then nobody is asked. Agemin's asset id (its public
# key), its secret (age_sk_...), and the public key its notices are signed with (PEM, line
# breaks as \n; read from its API when unset). Where Caime asks: org, paid, stranger.
# AGE_PROVIDER=agemin
# AGEMIN_ASSET_ID=
# AGEMIN_SECRET_KEY=
# AGEMIN_WEBHOOK_PUBLIC_KEY=
# AGE_CHECK_TRIGGERS=org,paid,stranger
# AGEMIN_API_URL=                     # another endpoint for Agemin's API (a stand-in)
# AGEMIN_VERIFY_URL=                  # and for its page

# Files in an S3-compatible bucket rather than on DATA_DIR (docs/DEPLOY.md, "Scaling"): all four, or none.
# FILES_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# FILES_S3_BUCKET=
# FILES_S3_ACCESS_KEY_ID=
# FILES_S3_SECRET_ACCESS_KEY=
# FILES_S3_REGION=auto
# FILES_S3_PREFIX=caime/files/
# FILES_S3_PATH_STYLE=true

# Mail (R48): the code that confirms an address and the link that resets a password.
# Without SMTP_URL nothing is sent and recovery codes are the way back.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# EMAIL_FROM=Caime <hello@cai.me>

# --- Everything else the server reads (docs/DEPLOY.md has each one's meaning) ---------------
# HOST=0.0.0.0                        # the address to listen on
# TRUST_PROXY=true                    # behind a reverse proxy (EasyPanel): read X-Forwarded-For
# WEB_DIR=../app/dist                 # the exported web app the server serves
# WORKERS=true                        # run the background workers in this process
# DATABASE_POOL_MAX=20
# SESSION_DAYS=90
# MINIMUM_AGE=13                      # the youngest age to sign up (docs/LEGAL-REVIEW-2026-10.md P6)
# HOSTING_PROVIDER=Hetzner Online GmbH, Germany   # named on the privacy page's processors list
# EDGE_PROVIDER=Cloudflare, Inc.                  # the network in front of the servers, when the domain is proxied
# VAPID_SUBJECT=mailto:hello@example.com         # web push's contact, on a domain you hold
# ANTHROPIC_BASE_URL=                 # another Messages API endpoint (a gateway, or a stand-in)
# SPEECH_BASE_URL=                    # another speech endpoint (a gateway, or a stand-in)
# Caime Mail (PRODUCT-REVIEW R75): every handle is an address at this domain, received and sent
# through the provider, whose inbound and delivery webhooks carry the secret
# (POST /v1/mail/in/<provider>?secret=… and /v1/mail/events/<provider>?secret=…). Off without
# MAIL_DOMAIN and MAIL_PROVIDER. Before production: the domain's MX at the provider, DKIM, SPF
# and DMARC, and the raw message sent with each inbound mail (Postmark's "Include raw email
# content"): who sent a mail is checked from it (docs/DEPLOY.md).
# MAIL_DOMAIN=cai.me
# MAIL_PROVIDER=postmark
# MAIL_PROVIDER_TOKEN=
# MAIL_WEBHOOK_SECRET=
# MAIL_STAFF_HANDLE=                  # who takes postmaster@, abuse@, hello@, support@… (a handle)
# MAIL_BASE_URL=                      # another endpoint for the provider's API (a stand-in)
# STRIPE_SECRET_KEY=                  # billing: live or test key; prices by lookup key
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PORTAL_CONFIGURATION=        # the billing portal configuration id
# STRIPE_API_BASE=                    # the tests' stand-in
# STRIPE_CONNECT_CLIENT_ID=           # an organization's own checkout (R65): Connect's ca_… id
# STRIPE_CONNECT_WEBHOOK_SECRET=      # the Connect endpoint's signing secret
# STRIPE_CONNECT_BASE=                # the tests' stand-in
# CLOUDFLARE_TURN_API_BASE=           # the tests' stand-in
# GOOGLE_AUTH_URL=                    # the tests' stand-in (and GOOGLE_TOKEN_URL, GOOGLE_PEOPLE_API)
# MICROSOFT_LOGIN_BASE=               # the tests' stand-in (and MICROSOFT_GRAPH_API)
